# Local demo configuration. Change these before real deployment.
DATABASE_URL=sqlite+aiosqlite:///./college_grievance.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
ESCALATION_DAYS=14
MAX_AUDIO_MB=10
TOKEN_EXPIRY_MINUTES=30
# Generate a long random value for real deployment:
JWT_SECRET=
DEVELOPER_MODE=false
DEVELOPER_KEY=
BOOTSTRAP_ADMIN_ID=admin001
BOOTSTRAP_ADMIN_NAME=System Administrator
# Set a strong password here before first startup if you want a predictable admin login.
BOOTSTRAP_ADMIN_PASSWORD=
